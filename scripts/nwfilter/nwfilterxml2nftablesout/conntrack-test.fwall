#nft list chain bridge libvirt_nwfilter_inet vnet0-in
table bridge libvirt_nwfilter_inet {
	chain vnet0-in {
		ether type ip ct direction reply ct state established accept
	}
}
#nft list chain bridge libvirt_nwfilter_inet vnet0-out
table bridge libvirt_nwfilter_inet {
	chain vnet0-out {
		ip protocol icmp ct count over 1 drop
		ether type ip meta l4proto tcp ct count over 2 drop
		ether type ip ct direction original ct state established,new accept
	}
}
#nft list chain bridge libvirt_nwfilter_ethernet vnet0-in
table bridge libvirt_nwfilter_ethernet {
	chain vnet0-in {
	}
}
#nft list chain bridge libvirt_nwfilter_ethernet vnet0-out
table bridge libvirt_nwfilter_ethernet {
	chain vnet0-out {
	}
}
