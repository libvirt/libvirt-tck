#nft list chain bridge libvirt_nwfilter_inet vnet0-in
table bridge libvirt_nwfilter_inet {
	chain vnet0-in {
		ether saddr 01:02:03:04:05:06 meta l4proto esp ip saddr 10.1.2.3 ip dscp 0x02 ct direction reply ct state established accept
		ether saddr 01:02:03:04:05:06 meta l4proto esp ip saddr 10.1.0.0/22 ip dscp 0x21 ct direction original ct state established,new accept
		ether saddr 01:02:03:04:05:06 meta l4proto esp ip saddr 10.1.0.0/22 ip dscp 0x21 ct direction original ct state established,new accept
	}
}
#nft list chain bridge libvirt_nwfilter_inet vnet0-out
table bridge libvirt_nwfilter_inet {
	chain vnet0-out {
		ether saddr 01:02:03:04:05:06 meta l4proto esp ip daddr 10.1.2.3 ip dscp 0x02 ct direction original ct state established,new accept
		ether saddr 01:02:03:04:05:06 meta l4proto esp ip daddr 10.1.0.0/22 ip dscp 0x21 ct direction reply ct state established accept
		ether saddr 01:02:03:04:05:06 meta l4proto esp ip daddr 10.1.0.0/22 ip dscp 0x21 ct direction reply ct state established accept
	}
}
#nft list chain bridge libvirt_nwfilter_ethernet vnet0-in
table bridge libvirt_nwfilter_ethernet {
	chain vnet0-in {
	}
}
#nft list chain bridge libvirt_nwfilter_ethernet vnet0-out
table bridge libvirt_nwfilter_ethernet {
	chain vnet0-out {
	}
}
